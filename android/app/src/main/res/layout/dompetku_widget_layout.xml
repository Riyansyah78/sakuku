<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Top Row: App Title & Date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SakuKu"
            android:textColor="#0F172A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hari Ini"
            android:textColor="#64748B"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Middle: 2 Cards (Income & Expense Hari Ini) -->
    <LinearLayout
        android:id="@+id/widget_summary_cards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <!-- Pemasukan Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_income_bg"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/widget_income_label"
                android:text="▲ Masuk Hari Ini"
                android:textColor="#15803D"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_today_income"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Rp 0"
                android:textColor="#166534"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Pengeluaran Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_expense_bg"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/widget_expense_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼ Keluar Hari Ini"
                android:textColor="#B91C1C"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_today_expense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Rp 0"
                android:textColor="#991B1B"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Transaksi Header -->
    <TextView
        android:id="@+id/widget_tx_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="3dp"
        android:text="TRANSAKSI TERAKHIR"
        android:textColor="#94A3B8"
        android:textSize="9sp"
        android:textStyle="bold" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/widget_tx_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Belum ada transaksi"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:visibility="visible" />

    <!-- Transaction 1 -->
    <LinearLayout
        android:id="@+id/widget_tx_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_tx_1_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Transaksi"
                android:textColor="#1E293B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_tx_1_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hari Ini"
                android:textColor="#64748B"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_tx_1_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp 0"
            android:textColor="#DC2626"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Divider 1 -->
    <FrameLayout
        android:id="@+id/widget_tx_divider_1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F1F5F9"
        android:visibility="gone" />

    <!-- Transaction 2 -->
    <LinearLayout
        android:id="@+id/widget_tx_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_tx_2_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Transaksi"
                android:textColor="#1E293B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_tx_2_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hari Ini"
                android:textColor="#64748B"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_tx_2_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp 0"
            android:textColor="#15803D"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Divider 2 -->
    <FrameLayout
        android:id="@+id/widget_tx_divider_2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F1F5F9"
        android:visibility="gone" />

    <!-- Transaction 3 -->
    <LinearLayout
        android:id="@+id/widget_tx_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_tx_3_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Transaksi"
                android:textColor="#1E293B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_tx_3_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hari Ini"
                android:textColor="#64748B"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_tx_3_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp 0"
            android:textColor="#DC2626"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Divider 3 -->
    <FrameLayout
        android:id="@+id/widget_tx_divider_3"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F1F5F9"
        android:visibility="gone" />

    <!-- Transaction 4 -->
    <LinearLayout
        android:id="@+id/widget_tx_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_tx_4_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Transaksi"
                android:textColor="#1E293B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_tx_4_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hari Ini"
                android:textColor="#64748B"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_tx_4_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp 0"
            android:textColor="#15803D"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
